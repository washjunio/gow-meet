{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "janela principal: comandos (inclusive vozes guardadas), eventos e abertura da transcrição (e da pasta dela) e dos Ajustes do Sistema",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-ensure-models",
    "allow-start-session",
    "allow-stop-session",
    "allow-list-sessions",
    "allow-rename-voice",
    "allow-list-voices",
    "allow-rename-saved-voice",
    "allow-delete-voice",
    "allow-delete-all-voices",
    "allow-set-language",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "x-apple.systempreferences:*" }] },
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$DATA/gow-meet/**" }] },
    "opener:allow-reveal-item-in-dir"
  ]
}
