{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "permissões das janelas main e overlay",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$DATA/gow-meet/**" }] }
  ]
}
